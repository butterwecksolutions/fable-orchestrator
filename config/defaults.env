# Fable Orchestrator — Sovereign defaults (copy to ~/.config/fable-orchestrator/env)
# Never commit real API keys.

# --- Cloud brain (only one active path is needed) ---
# fable | openai | xai | none
FABLE_BRAIN=fable

# Claude Code / Fable 5.1 (uses local `claude` CLI auth — no key here)
FABLE_EFFORT=low
# FABLE_MODEL=           # optional pin; empty = Claude default / settings

# OpenAI-compatible brain (GPT-5.6 Luna etc.)
# OPENAI_API_KEY=
OPENAI_BRAIN_BASE=https://api.openai.com/v1
OPENAI_BRAIN_MODEL=gpt-5.6

# xAI Grok brain
# XAI_API_KEY=
XAI_BRAIN_BASE=https://api.x.ai/v1
XAI_BRAIN_MODEL=grok-4

# --- Local workers (workstation / LiteLLM) ---
FABLE_LITELLM_BASE=http://127.0.0.1:4000/v1
FABLE_LITELLM_KEY=sk-local-sovereign

# CMP 170HX 64GB — large context, main implementation
FABLE_WORKER_HEAVY=coder
# RTX 3090 — loops, tests, high-throughput
FABLE_WORKER_FLASH=sidekick

# Concurrency hint for the task graph
FABLE_MAX_PARALLEL=2